{
  "functions": [
    {
      "source": "functions",
      "codebase": "default",
      "predeploy": ["node functions/gen-build-info.js"]
    }
  ],
  "hosting": {
    "public": ".",
    "ignore": [
      "firebase.json",
      "firestore.rules",
      "firestore.indexes.json",
      ".git/**",
      ".claude/**",
      ".playwright-cli/**",
      "output/**",
      "**/.*",
      "**/node_modules/**",
      "functions/**",
      "debug.log",
      "tests/**"
    ],
    "rewrites": [
      {
        "source": "/api/health",
        "function": {
          "functionId": "healthCheck",
          "region": "us-central1"
        }
      },
      {
        "source": "/q/**",
        "function": {
          "functionId": "redirectQr"
        }
      },
      { "source": "**", "destination": "/index.html" }
    ]
  },
  "firestore": {
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  }
}
