rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function validStatus(value) {
      return value in ["active", "inactive"];
    }

    match /qrRedirects/{slug} {
      allow read: if true;
      allow create: if signedIn()
        && !exists(/databases/$(database)/documents/qrRedirects/$(slug))
        && request.resource.data.keys().hasOnly(["qrId", "slug", "destinationUrl", "status", "updatedAt"])
        && request.resource.data.slug == slug
        && request.resource.data.destinationUrl is string
        && validStatus(request.resource.data.status);
      allow update: if signedIn()
        && request.resource.data.keys().hasOnly(["qrId", "slug", "destinationUrl", "status", "updatedAt"])
        && request.resource.data.slug == slug
        && request.resource.data.destinationUrl is string
        && validStatus(request.resource.data.status);
      allow delete: if false;
    }

    match /qrCodes/{qrId} {
      allow read: if signedIn();
      allow create: if signedIn()
        && request.resource.data.slug is string
        && request.resource.data.destinationUrl is string
        && validStatus(request.resource.data.status)
        && request.resource.data.scanCount == 0
        && request.resource.data.archived == false;
      allow update: if signedIn()
        || (
          request.resource.data.diff(resource.data).changedKeys().hasOnly(["scanCount", "lastScannedAt"])
          && request.resource.data.scanCount == resource.data.scanCount + 1
          && request.resource.data.status == resource.data.status
          && request.resource.data.slug == resource.data.slug
        );
      allow delete: if false;

      match /history/{historyId} {
        allow read, create: if signedIn();
        allow update, delete: if false;
      }
    }

    match /{document=**} {
      allow read, write: if signedIn();
    }
  }
}
